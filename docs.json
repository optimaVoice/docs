{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Optima Voice",
  "colors": {
    "primary": "#1A1A1A",
    "light": "#55B0FF",
    "dark": "#1A1A1A"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Vollkorn",
      "source": "/fonts/Vollkorn-Variable.woff2",
      "format": "woff2",
      "weight": 600
    },
    "body": {
      "family": "Vela Sans",
      "source": "/fonts/VelaSans-Variable.woff2",
      "format": "woff2",
      "weight": 500
    }
  },
  "rounded": "relaxed",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started",
              "agent-configuration",
              "voice-selection",
              "phone-numbers"
            ]
          },
          {
            "group": "Features",
            "pages": [
              "knowledge-base",
              "actions",
              "call-management",
              "integrations-overview"
            ]
          },
          {
            "group": "Phone Providers",
            "pages": [
              "sip-trunks/telnyx-setup",
              "sip-trunks/twilio-setup",
              "sip-trunks/zadarma-setup"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "billing",
              "security",
              "use-cases",
              "best-practices",
              "faq",
              "troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Optima API",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api-overview"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": [
              "changelog/index",
              "changelog/2026-02-17"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.optima-voice.com",
          "icon": "gauge"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start Free",
      "href": "https://app.optima-voice.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/optimavoice",
      "linkedin": "https://linkedin.com/company/optima-voice",
      "telegram": "https://t.me/optimavoice",
      "website": "https://optima-voice.com"
    }
  }
}
