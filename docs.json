{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Optima Voice",
  "colors": {
    "primary": "#1A1A1A",
    "light": "#6C63FF",
    "dark": "#1A1A1A"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Playfair Display",
      "weight": 700
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "rounded": "relaxed",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "getting-started",
              "voice-selection",
              "phone-numbers"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "agent-configuration",
              "knowledge-base",
              "actions",
              "call-management",
              "billing"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "use-cases",
              "best-practices",
              "troubleshooting"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.optima-voice.com",
          "icon": "gauge"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start Free",
      "href": "https://app.optima-voice.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/optimavoice",
      "linkedin": "https://linkedin.com/company/optima-voice"
    }
  }
}
